{
  "name": "5stack-inventory-plugin",
  "version": "0.1.0",
  "description": "CS2 inventory simulator — a 5stack Custom Pages micro-frontend. Rendered natively inside the 5stack panel via Module Federation; reuses 5stack Steam auth.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm install && vite build && (DEV_WATCH=1 vite build &) && node scripts/serve.mjs",
    "dev:ui": "npm run dev",
    "dev:api": "cd backend && npm install && node --watch --experimental-strip-types src/server.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run check:slots && npm run check:inspect && npm run check:stattrak && npm run check:steam-sync && npm run check:prices && npm run check:sfc",
    "check:slots": "node --experimental-strip-types tools/slot-whitelist-check.ts",
    "check:inspect": "node --experimental-strip-types tools/inspect-roundtrip.ts",
    "check:stattrak": "node --experimental-strip-types tools/stattrak-digits.ts",
    "check:steam-sync": "node --experimental-strip-types tools/steam-sync-coverage.ts",
    "check:prices": "node --experimental-strip-types tools/price-coverage.ts",
    "check:sfc": "node tools/sfc-parse-check.mjs",
    "check:charmsim": "npx --yes esbuild tools/charmsim-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/charmsim-check.mjs && node node_modules/.cache/charmsim-check.mjs"
  },
  "dependencies": {
    "@5stack/ui": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.508.0",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.2.0",
    "three": "^0.185.1",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "postcss-nesting": "^13.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue-tsc": "^2.1.10"
  }
}
