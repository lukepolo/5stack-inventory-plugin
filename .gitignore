# shader test rig output (regenerated on demand)
tools/shadertest/snapshots/

# extract-models.sh's work dir and tarball. Written INSIDE the container, and
# 5.5GB of it — see the matching entries in codepier.yaml's `ignore`, which are
# what actually stop it reaching this machine.
/cs2-model-extract/
/cs2-models-glb.tar.gz

# Agent worktrees. `git worktree add` puts real checkouts here, so an
# `add -A` would otherwise stage a second copy of the whole tree — and each
# one carries its own .git file, which git will happily commit as a plain file.
# The branches are the durable artifact; these directories are scratch.
/.claude/worktrees/
tools/shadertest/envsrc/
