{
  "$schema": "https://5stack.gg/schemas/plugin.json",
  "name": "Loadout",
  "slug": "inventory",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"currentColor\" viewBox=\"0 0 32 32\"><path d=\"M6 4h6a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-11a2 2 0 0 1 2-2ZM5.5 21h1.0a1.5 1.5 0 0 1 1.5 1.5v4.0a1.5 1.5 0 0 1-1.5 1.5h-1.0a1.5 1.5 0 0 1-1.5-1.5v-4.0a1.5 1.5 0 0 1 1.5-1.5ZM11.5 21h1.0a1.5 1.5 0 0 1 1.5 1.5v4.0a1.5 1.5 0 0 1-1.5 1.5h-1.0a1.5 1.5 0 0 1-1.5-1.5v-4.0a1.5 1.5 0 0 1 1.5-1.5ZM18 4h8a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2ZM18 13h8a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2ZM18 21h8a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2Z\"/></svg>",
  "remoteEntry": "/assets/remoteEntry.js",
  "scope": "inventory",
  "module": "./App",
  "requiredRole": "verified_user",
  "profileTabLabel": "Loadout",
  "featured": true,
  "deployments": ["inventory-frontend", "inventory-backend"],
  "install": {
    "overlays": {
      "http": "k8s/overlays/http",
      "https": "k8s/overlays/https"
    },
    "gateway": {
      "overlays": {
        "http": "k8s/gateway/http",
        "https": "k8s/gateway/https"
      }
    },
    "certificate": "inventory-ssl",
    "domain": {
      "prefix": "inventory",
      "var": "INVENTORY_DOMAIN",
      "file": "k8s/base/inventory.env"
    },
    "database": {
      "var": "DATABASE_URL",
      "file": "k8s/base/inventory-secrets.env"
    },
    "panel": {
      "file": "k8s/base/inventory.env"
    },
    "node": {
      "label": "5stack-inventory"
    }
  }
}
